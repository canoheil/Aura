TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.1-flash-lite
BOT_NAME=Aura
FOUNDER_USER_ID=YOUR_FOUNDER_USER_ID
YOU_API_KEY=YOUR_YOU_API_KEY
WEB_SEARCH_ENABLED=true
WEB_SEARCH_DAILY_LIMIT=100
WEB_SEARCH_MAX_RESULTS=10
WEB_SEARCH_CACHE_TTL=3600
WEB_SEARCH_CURRENT_CACHE_TTL=300
WEB_SEARCH_TIMEOUT=20
WEB_SEARCH_FRESHNESS=auto
WEB_SEARCH_COUNTRY=
WEB_SEARCH_LANGUAGE=
WEB_SEARCH_SAFESEARCH=moderate
WEB_SEARCH_EXTRACTION=highlights
WEB_SEARCH_CRAWL_TIMEOUT=10
WEB_SEARCH_OFFSET=0
WEB_SEARCH_INCLUDE_DOMAINS=
WEB_SEARCH_EXCLUDE_DOMAINS=
WEB_SEARCH_BOOST_DOMAINS=
WEB_SEARCH_TOOL_MAX_CALLS=4
# Force one search when a question is only correct if it is current (prices,
# news, releases, results, roles). Turn off to let the model decide alone.
WEB_SEARCH_ENFORCE=true
# Searches per day after which forcing stops and only nudging remains.
# 0 means 80% of WEB_SEARCH_DAILY_LIMIT, so forcing can never eat the whole quota.
WEB_SEARCH_ENFORCE_SOFT_LIMIT=0
# Extra comma-separated terms (Persian or English) that count as time-sensitive.
WEB_SEARCH_FORCE_TERMS=
WEB_CONTENTS_ENABLED=true
WEB_CONTENTS_DAILY_LIMIT=10
WEB_CONTENTS_CACHE_TTL=3600
WEB_CONTENTS_TIMEOUT=20
AGENT_MAX_ROUNDS=5
AGENT_MAX_TOOL_CALLS=10
MAX_HISTORY_MESSAGES=20
REQUEST_TIMEOUT=120
CONTEXT_COMPACT_THRESHOLD=24
CONTEXT_RECENT_MESSAGES=16
CONTEXT_SUMMARY_MAX_CHARS=6000
CONTEXT_MANAGER_ENABLED=true
YOUTUBE_TOOL_MAX_CALLS=2
FILE_MAX_SIZE_MB=15
FILE_MAX_EXTRACTED_CHARS=60000
FILE_TOOL_MAX_CALLS=2

# --- Smart sticker sending (Stage 21) ---
# Master switch for the send_sticker tool.
STICKERS_ENABLED=true
# Optional Telegram sticker set name override; defaults to set_name in stickers_config.json.
STICKER_SET_NAME=
# Optional path override for the sticker pack configuration file.
STICKER_CONFIG_PATH=
# Minimum seconds between automatic stickers per (chat, user) in private chats.
STICKER_COOLDOWN_SECONDS=60
# Minimum seconds between automatic stickers per (chat, user) in groups.
STICKER_GROUP_COOLDOWN_SECONDS=120
# Maximum send_sticker tool calls per agent run.
STICKER_TOOL_MAX_CALLS=1

# --- Pollinations image generation / editing (optional) ---
# Leave empty to keep image features disabled; Aura will not advertise them.
POLLINATIONS_API_KEY=
POLLINATIONS_ENABLED=true
# Text-to-image model and optional fallback (used if the primary model is rejected).
POLLINATIONS_IMAGE_MODEL=flux
POLLINATIONS_IMAGE_FALLBACK_MODEL=seedream
# Image-to-image model and optional fallback.
POLLINATIONS_EDIT_MODEL=kontext
POLLINATIONS_EDIT_FALLBACK_MODEL=nanobanana
# Read timeout for generation requests, in seconds.
POLLINATIONS_TIMEOUT=180
# Prompts are truncated to this length before being URL-encoded.
POLLINATIONS_MAX_PROMPT_CHARS=1500
POLLINATIONS_IMAGE_WIDTH=1024
POLLINATIONS_IMAGE_HEIGHT=1024
# Maximum generate_image tool calls per agent run.
POLLINATIONS_TOOL_MAX_CALLS=1
# Strip EXIF/GPS metadata when uploading a user photo for editing.
POLLINATIONS_UPLOAD_PRIVACY=true

# --- Weather via Open-Meteo (optional, keyless) ---
# Master switch for the get_weather tool. No API key is needed, no Docker.
WEATHER_ENABLED=true
# Endpoints for geocoding and forecast; empty disables the feature.
WEATHER_GEOCODE_URL=https://geocoding-api.open-meteo.com/v1/search
WEATHER_FORECAST_URL=https://api.open-meteo.com/v1/forecast
# Total timeout for geocoding + forecast, in seconds.
WEATHER_TIMEOUT=8
# How long to cache a city's weather, in seconds.
WEATHER_CACHE_TTL=600
# Maximum get_weather tool calls per agent run.
WEATHER_TOOL_MAX_CALLS=2

# --- Meme fetching (optional, keyless) ---
# Master switch for the fetch_meme tool. No API key is needed.
MEMES_ENABLED=true
# Primary and fallback endpoints for meme-api.com; empty disables the feature.
MEME_API_BASE_URL=https://meme-api.com
MEME_API_FALLBACK_URL=https://meme-api.aelx.de
# Timeout for one JSON request or one image download, in seconds.
MEME_API_TIMEOUT=12
# One deadline for the whole fetch (all retries, candidates and mirrors), in
# seconds. Keeps a broken service from holding a reply for minutes. 5-60.
MEME_FETCH_BUDGET_SECONDS=20
# Upper bound for a downloaded meme image, in bytes.
MEME_MAX_BYTES=6291456
# Allow NSFW-tagged memes (not recommended).
MEME_ALLOW_NSFW=false
# Comma-separated allowlist of subreddit names (without r/); empty allows any.
MEME_ALLOWED_SUBREDDITS=
# Maximum fetch_meme tool calls per agent run.
MEME_TOOL_MAX_CALLS=2

# --- Vector (SVG) image authoring ---
# Aura writes SVG herself and renders it locally to PNG with resvg-py.
# No external service, no API key, no image quota. Requires the resvg-py package.
SVG_IMAGE_ENABLED=true
# Maximum create_svg_image tool calls per agent run (retries after a bad SVG).
SVG_IMAGE_TOOL_MAX_CALLS=2
# Longest side of the rendered PNG; small drawings are scaled up, huge ones down.
SVG_IMAGE_MAX_SIDE=1536
# Upper bound for the rendered PNG size, in bytes.
SVG_IMAGE_MAX_OUTPUT_BYTES=8388608
# Optional canvas colour (e.g. #ffffff). Empty keeps the SVG's own background.
SVG_IMAGE_BACKGROUND=
